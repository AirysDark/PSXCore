{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PSXCore: Build ESP32-S3",
      "type": "shell",
      "command": "pio run -e esp32-s3",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PSXCore Client: Build Web",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/client" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PSXCore Client: Windows",
      "type": "shell",
      "command": "npm run tauri build",
      "options": { "cwd": "${workspaceFolder}/client" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "PSXCore: Build All",
      "dependsOrder": "sequence",
      "dependsOn": [
        "PSXCore: Build ESP32-S3",
        "PSXCore Client: Build Web",
        "PSXCore Client: Windows"
      ],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
