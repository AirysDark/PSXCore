{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSXCore Control",
  "version": "0.1.0",
  "identifier": "com.airysdark.psxcore.control",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "PSXCore Control",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
